# MariaDB Configuration
MARIADB_PORT=13306
MYSQL_DATABASE=swucjute_local
DB_USER=swucjute
DB_PASSWORD=changeme

# Redis Configuration
REDIS_PORT=16379

# MongoDB Configuration
MONGODB_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=changeme

# Kakao OAuth2 (카카오 디벨로퍼스 > 내 애플리케이션)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# JWT (secret must be at least 32 bytes for HS256)
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# Frontend (카카오 로그인 성공/실패 후 리다이렉트되는 프론트 주소)
FRONTEND_BASE_URL=http://localhost:5173
